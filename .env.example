# Copy this file to .env and fill in the values
# Google OAuth Client ID (same value as GOOGLE_CLIENT_ID in api/.env)
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public URL of the Laravel API as seen by the browser (defaults to local dev)
# Production example: https://api.example.com/api
# NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api
